<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinExplorer</AssemblyName>
    <RootNamespace>WinExplorer</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.1.6</Version>
    <FileVersion>1.1.6.0</FileVersion>
    <AssemblyTitle>WinExplorer</AssemblyTitle>
    <Description>Opens every folder as a tab in one File Explorer window, and switches to the tab that already shows it.</Description>
    <PackageProjectUrl>https://github.com/gghofsu/WinExplorer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gghofsu/WinExplorer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <!--
    UseWindowsForms adds global usings for System.Windows.Forms and System.Drawing, which
    collide with WPF types (Application, MessageBox, ...). Remove them; the few places that
    need WinForms import it explicitly.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinExplorer.Tests" />
  </ItemGroup>

</Project>
