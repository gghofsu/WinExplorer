root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,sln,manifest,xaml,resx}]
indent_size = 2

[*.{json,yml,yaml,md,ps1,iss}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Style
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Nullability / modern C#
csharp_style_prefer_null_check_over_type_check = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# Naming: private fields use an underscore prefix, interfaces start with I.
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

# Prefer explicit access modifiers; never rely on the default.
dotnet_style_require_accessibility_modifiers = always:warning

# Analyzers worth keeping on for a Win32 heavy project.
dotnet_diagnostic.CA1416.severity = none      # platform compatibility: this app is Windows only
dotnet_diagnostic.CA1031.severity = none      # catch (Exception) at the interop boundaries is intentional
dotnet_diagnostic.CA1303.severity = none      # log messages are developer facing
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.IDE0005.severity = suggestion   # unnecessary using
dotnet_diagnostic.IDE0161.severity = warning      # file scoped namespaces

[*.{yml,yaml}]
indent_size = 2
